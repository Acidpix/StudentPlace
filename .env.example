# ---------------------------------------------------------------------------
# StudentPlace — variables d'environnement
# Copier ce fichier en « .env » puis remplir les valeurs.
# Le script scripts/install.sh génère automatiquement les secrets sur le serveur.
# ---------------------------------------------------------------------------

# Emplacement de la base SQLite.
# En développement :  file:./prisma/dev.db
# En production :     file:/var/lib/studentplace/studentplace.db
DATABASE_URL="file:./prisma/dev.db"

# URL publique de l'application (sans slash final).
# Better Auth s'en sert pour les cookies de session et les liens d'e-mail.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret de signature des sessions.
# Générer avec :  openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Clé de chiffrement des commentaires sur les élèves (AES-256-GCM).
# DOIT faire exactement 32 octets encodés en base64.
# Générer avec :  openssl rand -base64 32
#
# ATTENTION : si cette clé est perdue ou modifiée, tous les commentaires
# déjà enregistrés deviennent définitivement illisibles. La sauvegarder
# au même titre que la base de données.
ENCRYPTION_KEY=""

# Port d'écoute du serveur Node (production).
PORT=3000
